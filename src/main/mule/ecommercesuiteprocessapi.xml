        <http:request method="POST" doc:name="POST /database/users" doc:id="38d212f8-6399-4c34-9156-112d1c390825" config-ref="HTTP_Request_configuration" path="/users" target="registrationReponse" />
        <ee:transform doc:name="JWT generation" doc:id="0ffb29de-2012-4b7a-a55d-f23b4ee212e3">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
import * from jwt::HMAC
output application/json
---
{
	jwtToken:JWT(
		{
			userId:payload.userId,
			iss:"ecommerce_suite_backend",
			aud:"ecommerce_api",
			iat:now() as Number {unit:"seconds"},
			exp:(now() + |PT3600S|) as Number {unit:"seconds"},
			role:payload.role,
			
		},
