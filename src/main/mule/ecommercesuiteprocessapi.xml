    <flow name="post:\users-login:application\json:ecommercesuiteprocessapi-config">
        <logger level="INFO" message="POST/auth/login called process api. continuing login request" />
        <http:request method="GET" doc:name="GET/users" doc:id="5f974c80-0377-4eca-9eca-b54fd9b56bdc" config-ref="HTTP_Request_configuration" path="/users" target="userData">
            <http:body><![CDATA[#[null]]]></http:body>
            <http:query-params><![CDATA[#[output application/java
---
{
	"email" : payload.email
}]]]></http:query-params>
        </http:request>
        <choice doc:name="Choice" doc:id="ca24e4b6-db7b-4dcc-97a8-fe79568ec207">
            <when expression="#[isEmpty(vars.userData)]">
                <raise-error doc:name="APP:USER_NOT_FOUND" doc:id="c05f2802-6d8d-4dbe-a63c-cdf712940938" type="APP:USER_NOT_FOUND" />
            </when>
            <when expression="#[!((vars.userData[0]).pass==payload.password)]">
                <raise-error doc:name="Raise error" doc:id="b7240ddd-ca16-4972-946c-0ab1b6226243" type="APP:PASSWORD_MISMATCH" />
            </when>
        </choice>
        <ee:transform doc:name="JWT generation" doc:id="c04853f1-9efb-474a-899a-779977813b33">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
import * from jwt::HMAC
output application/json
---
{
	jwtToken:JWT(
		{
			userId:(vars.userData)[0].userId,
			iss:"ecommerce_suite_backend",
			aud:"ecommerce_api",
			iat:now() as Number {unit:"seconds"},
			exp:(now() + |PT3600S|) as Number {unit:"seconds"},
			role:(vars.userData)[0].roles
		},
		p('jwt.secretKey')
	),
	userId:(vars.userData)[0].userId
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
        <error-handler>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="f0a9fefc-7ed1-405a-9ec6-034b04ea85d7" type="APP:USER_NOT_FOUND">
                <set-variable value="404" doc:name="httpStatus" doc:id="4c4cd128-bf09-4c69-85cb-2c8aa52fee38" variableName="httpStatus" />
                <set-payload value="#[&quot;USER NOT FOUND&quot;]" doc:name="Set Payload" doc:id="b96f22e3-02f7-4f9f-ac90-747fa9cd3c5b" />
            </on-error-propagate>
            <on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="ce87be89-9a56-441f-9aec-b1e753d264a6" type="APP:PASSWORD_MISMATCH">
                <set-variable value="401" doc:name="httpStatus" doc:id="e0b6b116-c91c-4a27-925e-65627377b88a" variableName="httpStatus" />
                <set-payload value="#[&quot;PLEASE PROVIDE CORRECT PASSWORD&quot;]" doc:name="Set Payload" doc:id="061b706d-40d3-4f6b-a9f4-78af14305553" />
            </on-error-propagate>
        </error-handler>
    </flow>
    <flow name="post:\users:application\json:ecommercesuiteprocessapi-config">
        <logger level="INFO" message="/exp/auth/register called process api. processing registration request" />
        <set-variable value="#[if(lower(payload.role==&quot;seller&quot;)) &quot;S-&quot; ++ uuid()[0 to 5] &#xA;else &quot;B-&quot; ++ uuid()[0 to 5]]" doc:name="Set Variable" doc:id="589b47f1-4137-46da-ab59-37c09e147973" variableName="userId" />
        <ee:transform doc:name="Transform Message" doc:id="a489a5eb-314e-4151-b871-06b94c340a53">
            <ee:message>
