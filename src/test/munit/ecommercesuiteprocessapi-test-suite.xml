		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="18dd4a35-f225-4889-8fc3-535be231b61d" type="APP:MUNIT_HELPER">
				<ee:transform doc:name="Transform Message" doc:id="919ecbcb-1db9-4101-9e57-28d588719091" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[attributes.queryParams.mockStatusCode]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
		</error-handler>
	</flow>
