	<munit:test name="post:\auth\login_userNotFound" doc:id="30189a20-b3b8-4f29-b12c-0eec28cbb33d" description="Test">
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mock when" doc:id="c735ec96-32bd-4af0-8491-94b6616bb478" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="4f90154b-c19e-4f22-9d4e-a64ffe881745" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:variables >
						<munit-tools:variable key="userData" value="#[[]]" />
					</munit-tools:variables>
				</munit-tools:then-return>
			</munit-tools:mock-when>
			<munit:set-event doc:name="Set Event" doc:id="5a762c91-fea3-40c4-b02a-df06c32338bd" >
				<munit:payload value='#[{&#10;  "email": "anuragninawe@gmail.com",&#10;  "password": "anurag"&#10;}]' />
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<try doc:name="Try" doc:id="ed14651c-e9d6-4b5e-b280-604d8f48ec89" >
				<flow-ref doc:name="Flow-ref to post:\auth\login:application\json:ecommercesuiteprocessapi-config" doc:id="9bcad402-8080-4ef6-b8bb-ea0aba8aefff" name="post:\auth\login:application\json:ecommercesuiteprocessapi-config" />
				<error-handler >
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="125b587b-fa51-4b20-bca6-c6b51835a3ef" />
				</error-handler>
			</try>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-that doc:name="Assert that" doc:id="4cffee86-1df3-4f73-b87a-9a5734e4ae2c" expression="#[vars.httpStatus as Number]" is="#[MunitTools::equalTo(404)]"/>
		</munit:validation>
	</munit:test>
