			<http:body ><![CDATA[#[%dw 2.0
output application/json
---
vars.mockPayload]]]></http:body>
			<http:query-params ><![CDATA[#[output application/java
---
{
	"mockStatusCode" : vars.mockStatusCode
}]]]></http:query-params>
		</http:request>
	</flow>
	<flow name="raiseError_mainFlow" doc:id="0a88b9cf-01b2-41d3-bc0d-17830df219e0" >
