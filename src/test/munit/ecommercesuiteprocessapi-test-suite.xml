	<munit:test name="post:\auth\register_emailConflict" doc:id="74866a07-8aa3-403b-8f88-116bebde8d59" description="Test">
		<munit:enable-flow-sources >
			<munit:enable-flow-source value="raiseError_mainFlow" />
		</munit:enable-flow-sources>
		<munit:behavior >
			<munit-tools:mock-when doc:name="POST/database/users" doc:id="83514922-1a9a-4943-8316-05c4b36f286a" processor="http:request">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="846147df-dcf7-4fa9-9285-7d153758fe48" attributeName="doc:id" />
				</munit-tools:with-attributes>
				<munit-tools:then-call flow="raiseError_request" />
			</munit-tools:mock-when>
			<munit:set-event doc:name="Set Event" doc:id="6eff7d0c-a6a4-48bd-a750-fe245df0d04e" >
				<munit:payload value='#[{&#10;  "firstName": "Anurag",&#10;  "lastName": "Ninave",&#10;  "email": "anuragninawe@gmail.com",&#10;  "phoneNo": "9404079128",&#10;  "city": "Nagpur",&#10;  "role": "seller",&#10;  "password": "anurag"&#10;}]' />
				<munit:variables >
					<munit:variable key="mockStatusCode" value="409" />
				</munit:variables>
			</munit:set-event>
		</munit:behavior>
		<munit:execution>
			<try doc:name="Try" doc:id="60a1959e-4e42-40b0-a283-e4e2496a6ee9" >
				<flow-ref doc:name="Flow-ref to post:\auth\register:application\json:ecommercesuiteprocessapi-config" doc:id="52885f3e-9125-4e20-9428-83324431234c" name="post:\auth\register:application\json:ecommercesuiteprocessapi-config" />
				<error-handler >
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="7a6627eb-951c-474c-9a2a-0679e1af0aba" />
				</error-handler>
			</try>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-equals doc:name="httpStatus" doc:id="3e16a5bd-40fc-4c86-8973-689b2e8cebea" actual="#[vars.httpStatus as Number]" expected="#[409]"/>
		</munit:validation>
	</munit:test>
	<flow name="raiseError_request" doc:id="cec8684a-660a-4fb9-8d52-3d8ea9f83e1f" >
		<http:request method="GET" doc:name="Request" doc:id="c06fcd0b-feef-47e8-b36c-e68464d5480b" config-ref="HTTP_Request_configuration" path="/raise/error">
			<http:body ><![CDATA[#[%dw 2.0
output application/json
---
vars.mockPayload]]]></http:body>
			<http:query-params ><![CDATA[#[output application/java
---
{
	"mockStatusCode" : vars.mockStatusCode
}]]]></http:query-params>
		</http:request>
	</flow>
	<flow name="raiseError_mainFlow" doc:id="0a88b9cf-01b2-41d3-bc0d-17830df219e0" >
		<http:listener doc:name="Listener" doc:id="1cac5fa2-5ad9-4a0d-9b78-df2c4a28095e" config-ref="HTTP_Listener_config_munit" path="/raise/error">
			<http:error-response statusCode="#[vars.httpStatus default 500]" />
		</http:listener>
		<raise-error doc:name="APP:MUNIT_HELPER" doc:id="70632dab-5b0e-4a75-876c-308903b182d4" type="APP:MUNIT_HELPER"/>
		<error-handler >
			<on-error-propagate enableNotifications="true" logException="true" doc:name="On Error Propagate" doc:id="18dd4a35-f225-4889-8fc3-535be231b61d" type="APP:MUNIT_HELPER">
				<ee:transform doc:name="Transform Message" doc:id="919ecbcb-1db9-4101-9e57-28d588719091" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
payload]]></ee:set-payload>
					</ee:message>
					<ee:variables >
						<ee:set-variable variableName="httpStatus" ><![CDATA[attributes.queryParams.mockStatusCode]]></ee:set-variable>
					</ee:variables>
				</ee:transform>
			</on-error-propagate>
		</error-handler>
	</flow>
	<munit:test name="post:\admin\setup_adminAlreadyRegsitered" doc:id="f1acab99-4b63-4d27-a7f3-97fa32a6457c" description="Test">
